{
  "title": "Inversión diaria por marca",
  "description": "Inversión digital estimada y pronóstico TimesFM por día, marca y plataforma de la categoría elegida, desde la fecha elegida y para la plataforma elegida (todas si no se elige). Reads infomedia_marts.mart_digital_predict_industria vía Windsor.",
  "source": {
    "kind": "query",
    "connector": "Windsor.ai",
    "tool": "get_data",
    "args": {
      "connector": "mysql",
      "accounts": [
        "reporting01.markplan.com__infomedia_marts__mart_digital_predict_industria"
      ],
      "fields": [
        "fecha",
        "categorias",
        "marcas",
        "plataformas",
        "digital_predict",
        "timesfm"
      ],
      "date_from": "{{desde}}",
      "date_filters": {
        "General": "fecha"
      },
      "filters": [
        [
          "categorias",
          "eq",
          "{{categoria}}"
        ],
        "and",
        [
          "plataformas",
          "contains",
          "{{plataforma}}"
        ]
      ]
    }
  }
}
