# Clave de la API de Windsor (Windsor.ai > API key). Solo vive en el servidor.
WINDSOR_API_KEY=
# Cuenta del conector mysql: tabla infomedia_marts.mart_digital_predict_industria
WINDSOR_ACCOUNT=reporting01.markplan.com__infomedia_marts__mart_digital_predict_industria
# Contraseña compartida del dashboard. Obligatoria: sin ella la API responde 500.
DASHBOARD_PASSWORD=
# Opcional: secreto extra para firmar la cookie de sesión (cualquier texto largo y aleatorio).
SESSION_SECRET=
